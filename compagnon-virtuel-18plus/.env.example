# ─── IA (Anthropic Claude) ─────────────────────────────────────────
ANTHROPIC_API_KEY=
# Modèle principal du personnage (modifiable, ex. claude-sonnet-4-5)
ANTHROPIC_MODEL=claude-sonnet-5
# Modèle rapide et économique pour la classification de modération
ANTHROPIC_MODERATION_MODEL=claude-haiku-4-5

# ─── Voix (ElevenLabs) ─────────────────────────────────────────────
ELEVENLABS_API_KEY=
# Voix par défaut si le persona n'en définit pas
ELEVENLABS_VOICE_ID=

# ─── Avatar vidéo (D-ID) ───────────────────────────────────────────
# Format attendu par D-ID : "utilisateur:motdepasse" (Basic auth) tel que fourni par le studio D-ID
DID_API_KEY=
# Image source par défaut de l'avatar (URL publique HTTPS d'un visage dont vous détenez les droits)
DID_DEFAULT_SOURCE_URL=

# ─── Données ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/compagnon?schema=public
# Laisser vide en développement = mémoire locale (pas besoin de Redis). Obligatoire en production.
REDIS_URL=

# ─── Auth ──────────────────────────────────────────────────────────
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# ─── Chiffrement des conversations (AES-256-GCM) ───────────────────
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# ─── Vérification d'âge ────────────────────────────────────────────
# "stripe" = Stripe Identity (production) | "dev" = simulation locale (refusée si NODE_ENV=production)
AGE_VERIFICATION_MODE=dev

# ─── Paiement (optionnel MVP) ──────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── Avatar temps réel (WebRTC D-ID, optionnel et plus coûteux) ────
DID_STREAMING=false
