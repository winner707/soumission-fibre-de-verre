# ---------------------------------------------------------------------------
# Supabase
# Tableau de bord > Project Settings > API
# ---------------------------------------------------------------------------

# URL du projet, exposee au navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://votre-projet.supabase.co

# Cle publique (« publishable key », anciennement « anon key »).
# Protegee par les politiques RLS : elle peut etre exposee au navigateur.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Cle de service. Elle contourne les politiques RLS : a garder cote serveur
# uniquement, jamais dans une variable NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL publique du site, utilisee pour les redirections apres connexion.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Twilio — notifications SMS (etape 5, non utilise pour l'instant)
# ---------------------------------------------------------------------------
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_PHONE_NUMBER=
